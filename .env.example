# Database (Neon/Postgres)
DATABASE_URL=postgresql://username:password@localhost:5432/gkanimates

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# Sync channel videos on /api/videos/all when true (Vercel cron or deploy)
SYNC_VIDEOS=false

# Optional: protect POST /api/sync (Vercel cron)
# SYNC_SECRET=your_random_secret

# SEO / Google Search Console (canonical domain for OG, sitemap, JSON-LD)
# NEXT_PUBLIC_SITE_URL=https://www.stickmananimations.com
# GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_token
